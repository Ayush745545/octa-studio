generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Idea {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String?
  status      String    @default("INBOX")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contents    Content[]
}

model Content {
  id           String        @id @default(cuid())
  title        String
  body         String?
  status       String        @default("DRAFT")
  platform     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ideaId       String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  idea         Idea?         @relation(fields: [ideaId], references: [id])
  media        Media[]
  publications Publication[]
}

model Media {
  id        String   @id @default(cuid())
  contentId String?
  url       String
  filename  String
  mimeType  String
  size      Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model PublishingChannel {
  id           String        @id @default(cuid())
  userId       String
  platform     String
  connected    Boolean       @default(false)
  accountName  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  externalId   String?
  authorUrn    String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([userId, platform])
}

model Publication {
  id              String            @id @default(cuid())
  contentId       String
  channelId       String
  status          String            @default("QUEUED")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalId      String?
  error           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  executionTimeMs Int?
  channel         PublishingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  content         Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, channelId])
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String?
  name           String?
  avatarUrl      String?
  provider       String              @default("credentials")
  plan           String              @default("FREE")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  generations      Generation[]
  payments         Payment[]
  publishingChannels PublishingChannel[]
  contentJobs      ContentJob[]
}

model Generation {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  tool      String?
  platform  String?
  prompt    String
  result    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String?
  plan              String
  amount            Int
  currency          String   @default("INR")
  status            String   @default("PENDING")
  razorpayOrderId   String?
  razorpayPaymentId String?
  mode              String   @default("razorpay")
  createdAt         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])
}

// ===========================================================================
// Creator Studio pipeline (durable, restart-safe, retryable)
// ===========================================================================

enum JobStatus {
  QUEUED
  PROCESSING
  READY_FOR_REVIEW
  APPROVED
  SCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

enum StageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum ClipStatus {
  PENDING
  GENERATING
  READY
  APPROVED
  SCHEDULED
  FAILED
  REJECTED
}

model ContentJob {
  id            String     @id @default(cuid())
  userId        String?
  // References an existing Media row (the uploaded long-form video).
  sourceMediaId String?
  // Denormalized source metadata for fast reads (UI project shape).
  sourceUrl     String?
  sourceFilename String?
  sourceSize    Int        @default(0)
  sourceDuration Float     @default(0)
  sourceWidth   Int        @default(0)
  sourceHeight  Int        @default(0)
  thumbnailUrl  String?
  schedulePlan  Json?
  scheduledCount Int       @default(0)
  status        JobStatus  @default(QUEUED)
  progress      Int        @default(0)
  currentStage  String?
  currentTask   String?
  error         String?
  errorMessage  String?
  retryCount    Int        @default(0)
  // Optimistic concurrency lock so two worker loops never process one job.
  lockedAt      DateTime?
  workerId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  stages    PipelineStage[]
  clips     ContentClip[]
  bundles   ContentBundle[]
  assets    GeneratedAsset[]

  @@index([status])
  @@index([userId])
  @@index([sourceMediaId])
}

model PipelineStage {
  id          String      @id @default(cuid())
  jobId       String
  job         ContentJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  status      StageStatus @default(PENDING)
  progress    Int         @default(0)
  error       String?
  retryCount  Int         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([jobId])
}

model ContentClip {
  id               String      @id @default(cuid())
  jobId            String
  job              ContentJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position         Int         @default(0)
  index            Int         @default(0)
  sourceStart      Float       @default(0)
  sourceEnd        Float       @default(0)
  durationSec      Float       @default(0)
  score            Int         @default(0)
  scores           Json?
  category         String?
  title            String?
  transcript       String?
  hookOriginal     String?
  hookAi           String?
  hook             String?
  useAiHook        Boolean     @default(true)
  caption          String?
  captionStyle     String?
  hashtags         String[]    @default([])
  platforms        String[]    @default([])
  recommendedTime  String?
  status           ClipStatus  @default(PENDING)
  error            String?
  // References an existing Media row (the rendered short).
  generatedMediaId String?
  // Denormalized asset URLs for fast reads (UI clip shape).
  videoUrl         String?
  thumbnailUrl     String?
  hasCaptions      Boolean     @default(false)
  contentId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  bundle ContentBundle?

  @@index([jobId])
}

model ContentBundle {
  id           String     @id @default(cuid())
  clipId       String     @unique
  clip         ContentClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  jobId        String
  job          ContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String?
  hook         String?
  caption      String?
  hashtags     String[]   @default([])
  thumbnail    String?
  score        Int        @default(0)
  status       String     @default("DRAFT")
  platformRecs String[]   @default([])
  contentId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([jobId])
}

model GeneratedAsset {
  id        String     @id @default(cuid())
  jobId     String
  job       ContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      String // audio | transcript | thumbnail | clip | caption | srt
  clipId    String?
  url       String
  filename  String?
  mimeType  String?
  size      Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([jobId])
  @@index([clipId])
}
